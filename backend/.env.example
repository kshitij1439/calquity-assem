# ─────────────────────────────────────────────
# ParcelPilot Agent — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# ── LLM Keys ──────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Qdrant ─────────────────────────────────────
# For local Docker: leave QDRANT_URL as http://localhost:6333, no API key needed
# For Qdrant Cloud: set URL + API key from your cluster dashboard
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=parcelpilot

# ── Postgres ───────────────────────────────────
# For local Docker Compose: use postgresql://parcelpilot:parcelpilot@postgres:5432/parcelpilot
# For Cloud Postgres / Neon: paste connection string below
DATABASE_URL=postgresql+asyncpg://parcelpilot:parcelpilot@postgres:5432/parcelpilot
SYNC_DATABASE_URL=postgresql://parcelpilot:parcelpilot@postgres:5432/parcelpilot

# ── JWT / Action Tokens ─────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ACTION_TOKEN_SECRET=change_me_to_a_random_hex_string
ACTION_TOKEN_TTL_SECONDS=300

# ── App Settings ───────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
